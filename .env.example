# ── Convex ────────────────────────────────────────────────────────────────────
# Set by `npx convex dev` (local) — do not edit by hand
CONVEX_DEPLOYMENT=

# Public URL of your Convex deployment (used by the Next.js client)
NEXT_PUBLIC_CONVEX_URL=

# ── Convex Auth (@convex-dev/auth) ────────────────────────────────────────────
# JWT_PRIVATE_KEY, JWKS and SITE_URL live ON THE CONVEX DEPLOYMENT, not here —
# `npx @convex-dev/auth` sets them (inspect with `npx convex env list`).

# ── OAuth providers (optional — set on the Convex deployment) ─────────────────
# Enables the "Continue with Google" button on the auth pages:
#   npx convex env set AUTH_GOOGLE_ID <client id>
#   npx convex env set AUTH_GOOGLE_SECRET <client secret>
# Create the OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application). Authorized redirect URI:
#   https://<deployment>.convex.site/api/auth/callback/google

# ── Payments (Phase 4) ────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email ─────────────────────────────────────────────────────────────────────
# Password-reset emails (PH0-17) are sent from Convex — set these ON THE
# DEPLOYMENT: `npx convex env set RESEND_API_KEY …` / `EMAIL_FROM …`.
# Without a key the reset link is printed to `npx convex logs` instead.
# Phase 4 (React Email templates) also uses it from Next.js:
RESEND_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
