# ── Convex ────────────────────────────────────────────────────────────────────
# Set by `npx convex dev` (local) — do not edit by hand
CONVEX_DEPLOYMENT=

# Public URL of your Convex deployment (used by the Next.js client)
NEXT_PUBLIC_CONVEX_URL=

# ── Convex Auth (@convex-dev/auth) ────────────────────────────────────────────
# Generated with `npx @convex-dev/auth` — used by the Convex AuthProvider action
CONVEX_AUTH_PRIVATE_KEY=

# ── OAuth providers (optional — add only the ones you enable) ─────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Payments (Phase 4) ────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (Phase 4) ───────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
